FRONTEND_PORT=3000

# Dosespot API Credentials
DOSESPOT_API_URL=https://my.dosespot.com/api/v1
DOSESPOT_API_KEY=your_dosespot_api_key

# Stripe API Credentials
STRIPE_SECRET_KEY=your_stripe_secret_key