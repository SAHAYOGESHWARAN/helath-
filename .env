# JWT Secret for authentication microservice
JWT_SECRET=your_jwt_secret_here

# Microservice Ports
AUTH_SERVICE_PORT=4005
GENAI_PORT=4000
EMR_SERVICE_PORT=4001
SCHEDULING_SERVICE_PORT=4002
NOTES_SERVICE_PORT=4003
VIDEO_SERVICE_PORT=4004
